  "extra_cards_over_time": {
    "principle": "Ship thin vertical slices: 1 pack complete (cover+objects+actions) before starting the next. Sensory hybrid: family packs plus predictive cards inside place packs. Bundles remix shipped packs; they are not new art.",
    "cadence": [
      {
        "phase": "A - taxonomy lock",
        "goal": "Families + planned stubs + pack specs",
        "deliverables": [
          "family-architecture.json",
          "routines.json families p1 + planned packs",
          "spec-ready JSON for 14 p1 packs"
        ]
      },
      {
        "phase": "B - art p1",
        "goal": "Artwork for p1 packs",
        "deliverables": [
          "trampoline-wow art",
          "sensory-world art",
          "health-appointments art",
          "eating-out + emergency-help art"
        ]
      },
      {
        "phase": "C - stories align",
        "goal": "Situation Stories handoff to shipped WOW only",
        "deliverables": [
          "Remap catalogue linked_routines",
          "Ship stories where WOW art is ready"
        ]
      },
      {
        "phase": "D0 - sports naming split",
        "goal": "Lock prep vs activity; split hybrid packs; retire -wow ids",
        "deliverables": [
          "family sports-activities",
          "7 sports split into prep + activity",
          "naming-governance.json + docs HTML",
          "legacy redirects for -wow hybrids"
        ]
      },
      {
        "phase": "D - p2",
        "goal": "school-college + money + health extras + sports-prep team",
        "deliverables": [
          "school-college family",
          "money-and-shopping family",
          "optician, hearing, physio, x-ray-or-scan",
          "football/basket/yoga prep + activity pairs",
          "public-toilet",
          "washing-hands"
        ]
      },
      {
        "phase": "E - p3 scale",
        "goal": "life-events + adventure sports + weather-seasons + home-living",
        "deliverables": [
          "life-events family (church, mosque, funeral, wedding first)",
          "skiing/surfing/snorkelling prep + activity pairs",
          "weather-seasons family + fireworks / back-to-school",
          "named seasonal bundles in catalogue UI",
          "home-living first five packs",
          "work-experience after school-college demand"
        ]
      }
    ],
    "card_budget_tips": [
      "Aim 12-18 cards per pack (cover + 4-7 objects + 7-12 actions); sensory and weather packs can be shorter",
      "Reuse shared objects (soap, towel, headphones) with pack-local accents when style matches",
      "Every public/travel/life-event pack should include at least 1 noise and 1 crowd card when clinically useful",
      "Emotions stay face-first; coping actions stay body+gesture with colour-matched sweater",
      "Restricted packs never in public shop filters",
      "Faith packs: shared etiquette objects where possible; place-specific cover and steps",
      "Sports: always ship prep + activity as a pair when possible",
      "Adventure sports: prep = kit/arrive/ready; activity = on-slope/in-water session steps",
      "Never create new -wow ids"
    ]
  },
  "metrics_for_premium": [
    "Staff can preview the hard moment (noise/crowd/wait) before the outing",
    "No two tickets look interchangeable",
    "Every emotion has two distinct, teachable coping moves",
    "Zero missing catalogue arts; zero same-pack hash dupes",
    "Genderless where the concept is universal (core, emotions, sensory)",
    "Health procedures never mixed into public-spaces hospital pack",
    "Life-event packs never collapse multiple faiths into one routine",
    "Bundles only reference packs that already have art"
  ],
  "naming_lock": {
    "sports_model": "Every sport has {sport}-prep (sports-prep family) + {sport}-activity (sports-activities family).",
    "forbidden_new": [
      "-wow",
      "bare sport label without Prep/Activity"
    ],
    "skill_decks": "Separate product; never named -prep.",
    "legacy_redirects": "climbing-wow, swimming-wow, gym-activities, hiking, trampoline-wow"
  }
}
