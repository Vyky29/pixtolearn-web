{
  "version": "1.0",
  "product": "PixtoLearn WOW Routines",
  "rule": "Option A: family base colour (corporate) + routine accent. Accent highlights the ACTION or hero object. White background always. One primary avatar + locked outfit per routine. Never mix ages mid-routine.",
  "framing": {
    "rule": "Frame for the gesture, not always full body. Cover = recognition (full or 3/4). Objects = single object. Actions = zoom on the clinical gesture.",
    "cover": "Full body or 3/4 so the routine is recognisable.",
    "object": "Single object, white bg, no person.",
    "action_face_hands": "Close-up face and/or hands. Use for brushing teeth, rinsing mouth, hair wash/rinse/dry/brush, squeeze bottle into hand.",
    "action_zone": "Crop to the body zone of the garment or step (feet for socks/shoes; waist/legs for trousers/pants; upper body for tops/jackets; head/hands for hat/scarf/gloves).",
    "action_body": "3/4 or full body only when the whole posture is the teaching point (wash body, dry body, cover-like steps).",
    "never": "Tiny full-body figure with a microscopic tool. Cropped forehead when a face is shown. Inner vignette boxes."
  },
